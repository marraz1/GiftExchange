# Neon Postgres (nemokamas Free planas)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Svetainės adresas (be / gale), pvz. https://gift-exchange.vercel.app
APP_URL=http://localhost:3000

# Atsitiktinė ilga eilutė nuorodų pasirašymui: openssl rand -base64 32
TOKEN_SECRET=change-me

# Gmail SMTP (Google paskyra -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=jusu.pastas@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Vercel Cron autentifikacija (atsitiktinė eilutė)
CRON_SECRET=change-me
