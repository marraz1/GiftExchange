# Neon Postgres (nemokamas Free planas)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Svetainės adresas (be / gale), pvz. https://gift-exchange.vercel.app (Vercel'yje nebūtinas)
APP_URL=http://localhost:3000

# Atsitiktinė ilga eilutė nuorodų pasirašymui: openssl rand -base64 32
TOKEN_SECRET=change-me

# Resend (nemokamas planas: 3000 laiškų/mėn., 100/d.)
RESEND_API_KEY=re_xxxxxxxx
# Siuntėjas. Be patvirtinto domeno palikite tuščią (naudos onboarding@resend.dev,
# bet laiškus galima siųsti TIK į jūsų Resend paskyros el. paštą).
EMAIL_FROM="Dovanų keitimasis <dovanos@jusu-domenas.lt>"

# Nebūtina: Gmail SMTP vietoje Resend (naudojamas tik jei RESEND_API_KEY tuščias)
# GMAIL_USER=jusu.pastas@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Vercel Cron autentifikacija (atsitiktinė eilutė)
CRON_SECRET=change-me
